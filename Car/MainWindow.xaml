<Window x:Class="Car.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mercedes-Benz Store"
        Height="650" Width="950"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1C2B4A" Offset="0"/>
            <GradientStop Color="#2E4A7A" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- ===== LEFT PANEL — Branding ===== -->
        <DockPanel Grid.Column="0" Margin="60,0,40,0">

            <StackPanel DockPanel.Dock="Top" VerticalAlignment="Center" Margin="0,100,0,0">

                <!-- Logo circle -->
                <Ellipse Width="75" Height="75"
                         Stroke="#5B9BD5" StrokeThickness="3"
                         HorizontalAlignment="Left" Margin="0,0,0,20"/>

                <TextBlock Text="MERCEDES-BENZ"
                           FontSize="30" FontWeight="Bold"
                           Foreground="White"
                           FontFamily="Georgia"/>

                <TextBlock Text="STORE"
                           FontSize="16" FontWeight="Light"
                           Foreground="#A0B8D8"
                           FontFamily="Georgia"
                           Margin="0,4,0,0"/>

                <Rectangle Height="2" Width="200" Fill="#5B9BD5"
                           HorizontalAlignment="Left" Margin="0,16,0,24"/>

                <TextBlock Text="Experience the pinnacle of automotive luxury."
                           FontSize="14" Foreground="#C8D8E8"
                           TextWrapping="Wrap" MaxWidth="320"
                           LineHeight="22"/>

                <TextBlock Text="&#10;Premium vehicles. Exceptional service."
                           FontSize="13" Foreground="#7A9ABF"
                           TextWrapping="Wrap" MaxWidth="320"/>
            </StackPanel>

            <TextBlock DockPanel.Dock="Bottom"
                       Text="© 2025 Mercedes-Benz Store. All rights reserved."
                       FontSize="11" Foreground="#4A6A8A"
                       Margin="0,0,0,30"/>
            <Grid/>
        </DockPanel>

        <!-- ===== RIGHT PANEL — Login Card ===== -->
        <Border Grid.Column="1"
                Background="#FFFFFF"
                CornerRadius="0">

            <StackPanel VerticalAlignment="Center" Margin="45,0">

                <TextBlock Text="Welcome Back"
                           FontSize="26" FontWeight="Bold"
                           Foreground="#1C2B4A" Margin="0,0,0,4"/>

                <TextBlock Text="Sign in to your account"
                           FontSize="13" Foreground="#6B8CAE"
                           Margin="0,0,0,30"/>

                <!-- Username -->
                <TextBlock Text="Username" Foreground="#4A6A8A"
                           FontSize="12" FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <Border BorderBrush="#B0C8E0" BorderThickness="1"
                        CornerRadius="6" Margin="0,0,0,18">
                    <TextBox x:Name="TxtUsername"
                             Background="#F0F6FF"
                             Foreground="#1C2B4A"
                             CaretBrush="#1C2B4A"
                             BorderThickness="0"
                             FontSize="14" Padding="12,10"
                             MaxLength="50"/>
                </Border>

                <!-- Password -->
                <TextBlock Text="Password" Foreground="#4A6A8A"
                           FontSize="12" FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <Border BorderBrush="#B0C8E0" BorderThickness="1"
                        CornerRadius="6" Margin="0,0,0,18">
                    <PasswordBox x:Name="TxtPassword"
                                 Background="#F0F6FF"
                                 Foreground="#1C2B4A"
                                 CaretBrush="#1C2B4A"
                                 BorderThickness="0"
                                 FontSize="14" Padding="12,10"
                                 MaxLength="100"/>
                </Border>

                <!-- Role -->
                <TextBlock Text="Select Role" Foreground="#4A6A8A"
                           FontSize="12" FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <Border BorderBrush="#B0C8E0" BorderThickness="1"
                        CornerRadius="6" Margin="0,0,0,28">
                    <ComboBox x:Name="CmbRole"
                              Background="#F0F6FF"
                              Foreground="#1C2B4A"
                              BorderThickness="0"
                              FontSize="14" Padding="10,9"
                              SelectedIndex="0">
                        <ComboBoxItem Content="Customer"    Tag="Customer"/>
                        <ComboBoxItem Content="Manager"     Tag="Manager"/>
                        <ComboBoxItem Content="Admin"       Tag="Admin"/>
                        <ComboBoxItem Content="Super Admin" Tag="SuperAdmin"/>
                    </ComboBox>
                </Border>

                <!-- Error message -->
                <Border x:Name="ErrorBorder"
                        Background="#FFF0F0"
                        BorderBrush="#FFB0B0"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,8"
                        Margin="0,0,0,12"
                        Visibility="Collapsed">
                    <TextBlock x:Name="TxtError"
                               Foreground="#C0392B"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Login Button -->
                <Button x:Name="BtnLogin"
                        Content="SIGN IN"
                        FontSize="14" FontWeight="Bold"
                        Foreground="White"
                        Height="46"
                        Cursor="Hand"
                        Click="BtnLogin_Click"
                        Margin="0,0,0,14">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="#2E6DB4"
                                                CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd"
                                                        Property="Background"
                                                        Value="#1C5A9E"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Divider -->
                <Grid Margin="0,0,0,14">
                    <Rectangle Height="1" Fill="#D0DCE8" VerticalAlignment="Center"/>
                    <Border Background="White" HorizontalAlignment="Center" Padding="10,0">
                        <TextBlock Text="or" Foreground="#8AAAC8" FontSize="12"/>
                    </Border>
                </Grid>

                <!-- Sign Up Button -->
                <Button x:Name="BtnSignUp"
                        Content="CREATE NEW ACCOUNT"
                        FontSize="13" FontWeight="Bold"
                        Height="44"
                        Cursor="Hand"
                        Click="BtnSignUp_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="White"
                                                BorderBrush="#2E6DB4"
                                                BorderThickness="2"
                                                CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd"
                                                        Property="Background"
                                                        Value="#EEF4FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="#2E6DB4"/>
                        </Style>
                    </Button.Style>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Window>