<Window x:Class="Car.Views.AddCarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add New Car" Height="560" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Background="#F0F4F8">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,30">
            <TextBlock Text="Add New Car" FontSize="22"
                       FontWeight="Bold" Foreground="#1C2B4A"
                       Margin="0,0,0,20"/>

            <!-- helper macro for fields -->
            <TextBlock Text="Car Name (e.g. C-Class)" Style="{StaticResource FieldLabel}"/>
            <Border Style="{StaticResource FieldBorder}">
                <TextBox x:Name="TxtName" Style="{StaticResource FieldBox}"/>
            </Border>

            <TextBlock Text="Model (e.g. C200 Avantgarde)" Style="{StaticResource FieldLabel}"/>
            <Border Style="{StaticResource FieldBorder}">
                <TextBox x:Name="TxtModel" Style="{StaticResource FieldBox}"/>
            </Border>

            <TextBlock Text="Year" Style="{StaticResource FieldLabel}"/>
            <Border Style="{StaticResource FieldBorder}">
                <TextBox x:Name="TxtYear" Style="{StaticResource FieldBox}"/>
            </Border>

            <TextBlock Text="Price (PKR)" Style="{StaticResource FieldLabel}"/>
            <Border Style="{StaticResource FieldBorder}">
                <TextBox x:Name="TxtPrice" Style="{StaticResource FieldBox}"/>
            </Border>

            <TextBlock Text="Color" Style="{StaticResource FieldLabel}"/>
            <Border Style="{StaticResource FieldBorder}">
                <TextBox x:Name="TxtColor" Style="{StaticResource FieldBox}"/>
            </Border>

            <TextBlock Text="Fuel Type" Style="{StaticResource FieldLabel}"/>
            <Border Style="{StaticResource FieldBorder}">
                <ComboBox x:Name="CmbFuel" BorderThickness="0"
                          Background="#F0F6FF" FontSize="13"
                          Padding="10,8" SelectedIndex="0">
                    <ComboBoxItem Content="Petrol"/>
                    <ComboBoxItem Content="Diesel"/>
                    <ComboBoxItem Content="Electric"/>
                </ComboBox>
            </Border>

            <TextBlock Text="Mileage (km, 0 = Brand New)"
                       Style="{StaticResource FieldLabel}"/>
            <Border Style="{StaticResource FieldBorder}">
                <TextBox x:Name="TxtMileage" Style="{StaticResource FieldBox}"
                         Text="0"/>
            </Border>

            <TextBlock Text="Initial Stock Count"
                       Style="{StaticResource FieldLabel}"/>
            <Border Style="{StaticResource FieldBorder}">
                <TextBox x:Name="TxtStock" Style="{StaticResource FieldBox}"
                         Text="1"/>
            </Border>

            <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/>
            <Border Style="{StaticResource FieldBorder}">
                <TextBox x:Name="TxtDesc" Style="{StaticResource FieldBox}"
                         Height="70" TextWrapping="Wrap"
                         AcceptsReturn="True"/>
            </Border>

            <Border x:Name="ErrBorder" Background="#FFF0F0"
                    BorderBrush="#FFB0B0" BorderThickness="1"
                    CornerRadius="6" Padding="10,7"
                    Margin="0,4,0,8" Visibility="Collapsed">
                <TextBlock x:Name="TxtErr" Foreground="#C0392B"
                           FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <Button Content="Add Car" Height="44" FontSize="14"
                    FontWeight="Bold" Foreground="White"
                    Cursor="Hand" Click="BtnAdd_Click"
                    Margin="0,4,0,0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#2E6DB4"
                                            CornerRadius="6">
                                        <ContentPresenter
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd"
                                                    Property="Background"
                                                    Value="#1C5A9E"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </ScrollViewer>
</Window>