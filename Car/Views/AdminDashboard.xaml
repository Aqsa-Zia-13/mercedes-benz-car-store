<Window x:Class="Car.Views.AdminDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Dashboard — Mercedes-Benz Store"
        Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F0F4F8">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <DockPanel Grid.Column="0" Background="#16213e">
            <StackPanel DockPanel.Dock="Top" Margin="20,30,20,10">
                <TextBlock Text="MERCEDES-BENZ" FontSize="13"
                           FontWeight="Bold" Foreground="#5B9BD5"/>
                <TextBlock Text="STORE" FontSize="10"
                           Foreground="#4A6A8A" Margin="0,2,0,0"/>
                <Rectangle Height="1" Fill="#2a3a5a"
                           Margin="0,14,0,14"/>
                <TextBlock x:Name="TxtWelcome" Text="Welcome"
                           FontSize="13" Foreground="White"
                           TextWrapping="Wrap"/>
                <TextBlock Text="Administrator" FontSize="11"
                           Foreground="#5B9BD5" Margin="0,3,0,0"/>
            </StackPanel>
            <Button DockPanel.Dock="Bottom" Content="⬅  Logout"
                    FontSize="12" Foreground="#6B8CAE"
                    Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Left" Cursor="Hand"
                    Margin="20,0,0,24" Click="BtnLogout_Click"/>
            <StackPanel Margin="0,8,0,0">
                <Button Content="📦  Orders"
                        Tag="Orders" Click="NavBtn_Click"
                        Style="{StaticResource NavBtn}"/>
                <Button Content="🚗  Car Inventory"
                        Tag="Inventory" Click="NavBtn_Click"
                        Style="{StaticResource NavBtn}"/>
                <Button Content="📊  Reports"
                        Tag="Reports" Click="NavBtn_Click"
                        Style="{StaticResource NavBtn}"/>
            </StackPanel>
        </DockPanel>

        <!-- Main -->
        <Grid Grid.Column="1">

            <!-- ORDERS PANEL -->
            <DockPanel x:Name="PanelOrders" Visibility="Visible">
                <Border DockPanel.Dock="Top" Background="White"
                        BorderBrush="#D8E4F0" BorderThickness="0,0,0,1"
                        Padding="24,16">
                    <TextBlock Text="All Orders" FontSize="22"
                               FontWeight="Bold" Foreground="#16213e"/>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="OrdersPanel" Margin="24,16"/>
                </ScrollViewer>
            </DockPanel>

            <!-- INVENTORY PANEL -->
            <DockPanel x:Name="PanelInventory" Visibility="Collapsed">
                <Border DockPanel.Dock="Top" Background="White"
                        BorderBrush="#D8E4F0" BorderThickness="0,0,0,1"
                        Padding="24,16">
                    <Grid>
                        <TextBlock Text="Car Inventory Management"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="#16213e"
                                   VerticalAlignment="Center"/>
                        <Button Content="+ Add New Car"
                                HorizontalAlignment="Right"
                                Height="36" Padding="16,0"
                                FontSize="12" FontWeight="Bold"
                                Foreground="White" Cursor="Hand"
                                Click="BtnAddCar_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="#2E6DB4"
                                                        CornerRadius="6">
                                                    <ContentPresenter
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="#1C5A9E"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="InventoryPanel" Margin="24,16"/>
                </ScrollViewer>
            </DockPanel>

            <!-- REPORTS PANEL -->
            <DockPanel x:Name="PanelReports" Visibility="Collapsed">
                <Border DockPanel.Dock="Top" Background="White"
                        BorderBrush="#D8E4F0" BorderThickness="0,0,0,1"
                        Padding="24,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Reports"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="#16213e"
                                   VerticalAlignment="Center"
                                   Margin="0,0,20,0"/>
                        <DatePicker x:Name="DpFrom"
                                    Width="140" Margin="0,0,8,0"
                                    FontSize="13"/>
                        <DatePicker x:Name="DpTo"
                                    Width="140" Margin="0,0,12,0"
                                    FontSize="13"/>
                        
                        
                        
                        
                        
                        <!--<Button Content="🔍 Generate"
                                Height="36" Padding="14,0"
                                FontSize="12" FontWeight="Bold"
                                Foreground="White" Cursor="Hand"
                                Click="BtnGenReport_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="#2E6DB4"
                                                        CornerRadius="6">
                                                    <ContentPresenter
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="#1C5A9E"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>-->


                        <Button Content="Generate Report"
        Height="38"
        Padding="18,0"
        FontSize="13"
        FontWeight="Bold"
        Foreground="White"
        Background="#2E6DB4"
        BorderThickness="0"
        Cursor="Hand"
        Click="BtnGenReport_Click"/>
                        
                        







                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ReportsPanel" Margin="24,16"/>
                </ScrollViewer>
            </DockPanel>

        </Grid>
    </Grid>
</Window>