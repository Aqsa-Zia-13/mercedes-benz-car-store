<Window x:Class="Car.Views.CheckoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Checkout" Height="460" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">

    <StackPanel Margin="36,30,36,30">

        <TextBlock Text="Order Confirmation"
                   FontSize="22" FontWeight="Bold"
                   Foreground="#1C2B4A" Margin="0,0,0,20"/>

        <!-- Car info box -->
        <Border Background="#F0F6FF" CornerRadius="8"
                BorderBrush="#B0C8E0" BorderThickness="1"
                Padding="18" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock x:Name="TxtCarName"
                           FontSize="17" FontWeight="Bold"
                           Foreground="#1C2B4A"/>
                <TextBlock x:Name="TxtCarDetails"
                           FontSize="12" Foreground="#6B8CAE"
                           Margin="0,4,0,10"/>
                <TextBlock x:Name="TxtCarPrice"
                           FontSize="22" FontWeight="Bold"
                           Foreground="#2E6DB4"/>
            </StackPanel>
        </Border>

        <!-- Payment -->
        <TextBlock Text="Payment Method"
                   FontSize="13" FontWeight="SemiBold"
                   Foreground="#4A6A8A" Margin="0,0,0,8"/>
        <Border Background="#F8FBFF" CornerRadius="8"
                BorderBrush="#D0DCE8" BorderThickness="1"
                Padding="14" Margin="0,0,0,24">
            <RadioButton Content="Cash on Delivery"
                         IsChecked="True"
                         FontSize="13" Foreground="#1C2B4A"/>
        </Border>

        <!-- Error label -->
        <TextBlock x:Name="TxtError"
                   Foreground="Red" FontSize="12"
                   Visibility="Collapsed"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

        <!-- Buttons — plain, no templates -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Cancel"
                    Height="44" FontSize="13"
                    Background="#F0F4F8"
                    BorderBrush="#B0C8E0"
                    BorderThickness="1"
                    Foreground="#4A6A8A"
                    Cursor="Hand"
                    Click="BtnCancel_Click"/>

            <Button Grid.Column="2"
                    x:Name="BtnConfirm"
                    Content="Confirm Purchase"
                    Height="44" FontSize="13"
                    FontWeight="Bold"
                    Background="#2E6DB4"
                    BorderThickness="0"
                    Foreground="White"
                    Cursor="Hand"
                    Click="BtnConfirm_Click"/>
        </Grid>

    </StackPanel>
</Window>
    